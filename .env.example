# Kopieer naar .env.local voor lokaal ontwikkelen. Echte waarden nooit committen.
DATABASE_URL=postgresql://newszoom:newszoom@localhost/newszoom
APP_URL=http://localhost:3000

# Inloggen met een craftstudio-account (Supabase Auth, dezelfde login als de todo-app).
# Op de server het interne adres via Docker-netwerk supabase_default; het publieke adres
# wordt vanaf de server door Cloudflare geblokkeerd. Alleen de publieke anon key, nooit service-role.
# CRAFTSTUDIO_AUTH_URL=http://supabase-kong:8000
# CRAFTSTUDIO_AUTH_KEY=

# Achtergrond op aanvraag met een taalmodel dat op het web zoekt. Eén key is genoeg.
# Provider, model en budget kun je ook in de app wijzigen (Menu → Instellingen).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NZ_LLM_PROVIDER=openai        # openai, anthropic of uit
# NZ_LLM_BUDGET_USD=10          # maandbudget in dollar
